# Neon PostgreSQL (primary database)
DATABASE_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"

# Cloudflare R2 (almacenamiento de imágenes, compatible con la API de S3)
R2_ACCOUNT_ID="tu-account-id"
R2_ACCESS_KEY_ID="tu-access-key-id"
R2_SECRET_ACCESS_KEY="tu-secret-access-key"
R2_BUCKET_NAME="tu-bucket-name"
R2_PUBLIC_URL="https://pub-xxxxxxxx.r2.dev"

# Autenticación (Auth.js + Google OAuth)
# AUTH_SECRET: generar con `openssl rand -base64 32` (o https://generate-secret.vercel.app/32)
AUTH_SECRET="genera-un-secreto-aleatorio"
# Credenciales OAuth de Google Cloud Console (APIs & Services -> Credentials)
GOOGLE_CLIENT_ID="xxxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="tu-client-secret"
# Emails de Google autorizados a entrar al admin, separados por coma
ADMIN_EMAILS="tu-email@gmail.com"
